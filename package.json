{
  "name": "darkvault-launcher",
  "version": "0.1.0",
  "description": "DarkVault Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.darkvault.launcher",
    "productName": "DarkVault Launcher",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "DarkVault-Launcher-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}